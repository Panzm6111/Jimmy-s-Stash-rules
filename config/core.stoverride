- name: 国内直连
  type: select
  proxies:
  - DIRECT
- name: 广告拦截
  type: select
  proxies:
  - REJECT
  - DIRECT
rule-providers:
  基础广告:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/ads-basic.yaml
    interval: 86400
  海外AI:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/openai.yaml
    interval: 86400
  Netflix:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/netflix.yaml
    interval: 86400
  YouTube:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/youtube.yaml
    interval: 86400
  Telegram:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/telegram.yaml
    interval: 86400
  Apple服务:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/apple.yaml
    interval: 86400
  Microsoft服务:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/microsoft.yaml
    interval: 86400
  国内服务:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/china.yaml
    interval: 86400
rules:
- DOMAIN-SUFFIX,local,DIRECT
- DOMAIN-SUFFIX,lan,DIRECT
- DOMAIN,localhost,DIRECT
- IP-CIDR,0.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
- IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
- IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
- IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
- IP-CIDR6,::1/128,DIRECT,no-resolve
- IP-CIDR6,fc00::/7,DIRECT,no-resolve
- IP-CIDR6,fe80::/10,DIRECT,no-resolve
- DOMAIN-SUFFIX,push.apple.com,DIRECT
- DOMAIN-SUFFIX,icloud.com,DIRECT
- DOMAIN-SUFFIX,icloud-content.com,DIRECT
- DOMAIN,ocsp.apple.com,DIRECT
- DOMAIN,mesu.apple.com,DIRECT
- DOMAIN,swscan.apple.com,DIRECT
- DOMAIN,swdownload.apple.com,DIRECT
- DOMAIN,swcdn.apple.com,DIRECT
- DOMAIN-SUFFIX,windowsupdate.com,DIRECT
- DOMAIN-SUFFIX,update.microsoft.com,DIRECT
- DOMAIN,download.microsoft.com,DIRECT
- DOMAIN,login.live.com,DIRECT
- DOMAIN,login.microsoftonline.com,DIRECT
- RULE-SET,基础广告,广告拦截
- RULE-SET,海外AI,海外AI
- RULE-SET,Netflix,Netflix
- RULE-SET,YouTube,YouTube
- RULE-SET,Telegram,Telegram
- RULE-SET,Apple服务,Apple
- RULE-SET,Microsoft服务,Microsoft
- RULE-SET,国内服务,国内直连
- GEOIP,CN,国内直连
- MATCH,未匹配流量
