name: Jimmy 公共分流
desc: 与本机 main.yaml 和私人订阅覆写搭配；默认拒绝海外流量，请先选择总代理。
proxy-groups:
- name: 总代理
  type: select
  proxies:
  - REJECT
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  - DIRECT
- name: 手动节点
  type: select
  proxies:
  - REJECT
  use:
  - 机场
- name: 美国
  type: fallback
  url: https://www.gstatic.com/generate_204
  interval: 1800
  proxies:
  - REJECT
  use:
  - 机场
  filter: (?i)(美国|美國|美西|美东|美東|洛杉矶|洛杉磯|纽约|紐約|西雅图|西雅圖|圣何塞|聖何塞|🇺🇸|united[ _-]*states|los[ _-]*angeles|new[ _-]*york|seattle|san[
    _-]*jose|(^|[^a-z])(us|usa)([^a-z]|$)|^REJECT$)
- name: 日本
  type: fallback
  url: https://www.gstatic.com/generate_204
  interval: 1800
  proxies:
  - REJECT
  use:
  - 机场
  filter: (?i)(日本|东京|東京|大阪|🇯🇵|japan|tokyo|osaka|(^|[^a-z])jp([^a-z]|$)|^REJECT$)
- name: 香港
  type: fallback
  url: https://www.gstatic.com/generate_204
  interval: 1800
  proxies:
  - REJECT
  use:
  - 机场
  filter: (?i)(香港|🇭🇰|hong[ _-]*kong|(^|[^a-z])hk([^a-z]|$)|^REJECT$)
- name: 新加坡
  type: fallback
  url: https://www.gstatic.com/generate_204
  interval: 1800
  proxies:
  - REJECT
  use:
  - 机场
  filter: (?i)(新加坡|狮城|獅城|🇸🇬|singapore|(^|[^a-z])sg([^a-z]|$)|^REJECT$)
- name: 台湾
  type: fallback
  url: https://www.gstatic.com/generate_204
  interval: 1800
  proxies:
  - REJECT
  use:
  - 机场
  filter: (?i)(台湾|台灣|臺灣|台北|臺北|🇹🇼|taiwan|taipei|(^|[^a-z])tw([^a-z]|$)|^REJECT$)
- name: OpenAI
  type: select
  proxies:
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  - DIRECT
  use:
  - 机场
- name: Netflix
  type: select
  proxies:
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  - DIRECT
  use:
  - 机场
- name: YouTube
  type: select
  proxies:
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  - DIRECT
  use:
  - 机场
- name: Telegram
  type: select
  proxies:
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  - DIRECT
  use:
  - 机场
- name: Apple
  type: select
  proxies:
  - DIRECT
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  use:
  - 机场
- name: Microsoft
  type: select
  proxies:
  - DIRECT
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  use:
  - 机场
- name: 未匹配流量
  type: select
  proxies:
  - 总代理
  - 美国
  - 日本
  - 香港
  - 新加坡
  - 台湾
  - 手动节点
  - DIRECT
  use:
  - 机场
- name: 国内直连
  type: select
  proxies:
  - DIRECT
- name: 广告拦截
  type: select
  proxies:
  - REJECT
  - DIRECT
rule-providers:
  基础广告:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/ads-basic.yaml
    interval: 86400
  OpenAI:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/openai.yaml
    interval: 86400
  Netflix:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/netflix.yaml
    interval: 86400
  YouTube:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/youtube.yaml
    interval: 86400
  Telegram:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/telegram.yaml
    interval: 86400
  Apple服务:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/apple.yaml
    interval: 86400
  Microsoft服务:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/microsoft.yaml
    interval: 86400
  国内服务:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/rules/vendor/china.yaml
    interval: 86400
rules:
- DOMAIN-SUFFIX,local,DIRECT
- DOMAIN-SUFFIX,lan,DIRECT
- DOMAIN,localhost,DIRECT
- IP-CIDR,0.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
- IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
- IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
- IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
- IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
- IP-CIDR6,::1/128,DIRECT,no-resolve
- IP-CIDR6,fc00::/7,DIRECT,no-resolve
- IP-CIDR6,fe80::/10,DIRECT,no-resolve
- DOMAIN-SUFFIX,push.apple.com,DIRECT
- DOMAIN-SUFFIX,icloud.com,DIRECT
- DOMAIN-SUFFIX,icloud-content.com,DIRECT
- DOMAIN,ocsp.apple.com,DIRECT
- DOMAIN,mesu.apple.com,DIRECT
- DOMAIN,swscan.apple.com,DIRECT
- DOMAIN,swdownload.apple.com,DIRECT
- DOMAIN,swcdn.apple.com,DIRECT
- DOMAIN-SUFFIX,windowsupdate.com,DIRECT
- DOMAIN-SUFFIX,update.microsoft.com,DIRECT
- DOMAIN,download.microsoft.com,DIRECT
- DOMAIN,login.live.com,DIRECT
- DOMAIN,login.microsoftonline.com,DIRECT
- RULE-SET,基础广告,广告拦截
- RULE-SET,OpenAI,OpenAI
- RULE-SET,Netflix,Netflix
- RULE-SET,YouTube,YouTube
- RULE-SET,Telegram,Telegram
- RULE-SET,Apple服务,Apple
- RULE-SET,Microsoft服务,Microsoft
- RULE-SET,国内服务,国内直连
- GEOIP,CN,国内直连
- MATCH,未匹配流量
