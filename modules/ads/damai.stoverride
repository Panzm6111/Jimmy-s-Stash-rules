# Generated from research/ad-catalog.json; edit the catalog, then regenerate.
name: 大麦广告专项（可选）
desc: 专用 home.welcome 开屏；不屏蔽 HTTPDNS、票务或下单。默认不导入；需设备验收。
script-providers:
  jimmy_ad_empty_response:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/empty-response.js
    interval: 86400
http:
  mitm:
  - acs.m.taobao.com
  script:
  - match: ^https://acs\.m\.taobao\.com/gw/mtop\.damai\.wireless\.home\.welcome(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?|$)
    name: jimmy_ad_empty_response
    type: request
    require-body: false
    timeout: 5
