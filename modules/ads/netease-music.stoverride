# Generated from research/ad-catalog.json; edit the catalog, then regenerate.
name: 网易云音乐广告专项（可选）
desc: 仅3个精确主机的 api/ad 或 eapi/ad 路径候选；不解密 EAPI 正文。默认不导入；需设备验收。
script-providers:
  jimmy_ad_empty_response:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/empty-response.js
    interval: 86400
http:
  mitm:
  - interface.music.163.com
  - interface3.music.163.com
  - ipv4.music.163.com
  script:
  - match: ^https://interface\.music\.163\.com/e?api/ad(?:/[^?#]*)?(?:\?|$)
    name: jimmy_ad_empty_response
    type: request
    require-body: false
    timeout: 5
  - match: ^https://interface3\.music\.163\.com/e?api/ad(?:/[^?#]*)?(?:\?|$)
    name: jimmy_ad_empty_response
    type: request
    require-body: false
    timeout: 5
  - match: ^https://ipv4\.music\.163\.com/e?api/ad(?:/[^?#]*)?(?:\?|$)
    name: jimmy_ad_empty_response
    type: request
    require-body: false
    timeout: 5
