name: 阿里云盘广告专项（可选）
desc: AD-20261020.1；仅 onboard_list 的4种推广banner；不宣称阿里云盘开屏或全界面去广告。独立启停；需设备验收。
script-providers:
  jimmy_alipan_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/alipan.js
    interval: 86400
http:
  mitm:
  - member.alipan.com
  script:
  - match: ^https://member\.alipan\.com/v1/users/onboard_list/?(?:\?|$)
    name: jimmy_alipan_ads
    type: response
    require-body: true
    timeout: 5
    argument: diagnostic=0
