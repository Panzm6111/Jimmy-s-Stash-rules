name: WPS Office广告专项（可选）
desc: 广告统计及 feeds_ad 图片；不改会员、文档、云同步。默认不导入；需设备验收。
http:
  mitm:
  - ios.wps.cn
  - mobile-pic.cache.iciba.com
  rewrite:
  - ^https://ios\.wps\.cn/ad-statistics-service(?:/[^?#]*)?(?:\?|$) - reject
  - ^https://mobile\-pic\.cache\.iciba\.com/feeds_ad/[^?#]*(?:\?|$) - reject
