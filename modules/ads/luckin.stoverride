name: 瑞幸咖啡广告专项（可选）
desc: 仅 sys/app/adposNew 独立广告响应；保留点单、商品与优惠券。默认不导入；需设备验收。
script-providers:
  jimmy_luckin_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/luckin.js
    interval: 86400
http:
  mitm:
  - capi.lkcoffee.com
  script:
  - match: ^https://capi\.lkcoffee\.com/resource/m/sys/app/adposNew/?(?:\?|$)
    name: jimmy_luckin_ads
    type: response
    require-body: true
    timeout: 5
