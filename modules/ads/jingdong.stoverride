# Generated from research/ad-catalog.json; edit the catalog, then regenerate.
name: 京东广告专项（可选）
desc: AD-20261020.1；仅 URL 中 functionId=start 的历史开屏展示字段；不包含全部京东广告。独立启停；需设备验收。
script-providers:
  jimmy_jingdong_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/jingdong.js
    interval: 86400
http:
  mitm:
  - api.m.jd.com
  script:
  - match: ^https://api\.m\.jd\.com/client\.action\?(?:[^#&]*&)*functionId=start(?:&|$)
    name: jimmy_jingdong_ads
    type: response
    require-body: true
    timeout: 5
    argument: diagnostic=0
