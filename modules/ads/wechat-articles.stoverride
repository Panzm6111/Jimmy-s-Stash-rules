# Generated from research/ad-catalog.json; edit the catalog, then regenerate.
name: 微信广告专项（可选）
desc: AD-20261020.1；仅历史公众号 getappmsgad 的广告字段；不包含朋友圈、视频号或聊天。独立启停；需设备验收。
script-providers:
  jimmy_wechat_articles_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/wechat-articles.js
    interval: 86400
http:
  mitm:
  - mp.weixin.qq.com
  script:
  - match: ^https://mp\.weixin\.qq\.com/mp/getappmsgad/?(?:\?|$)
    name: jimmy_wechat_articles_ads
    type: response
    require-body: true
    timeout: 5
    argument: diagnostic=0
