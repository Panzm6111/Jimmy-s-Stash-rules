# SPDX-License-Identifier: GPL-3.0-only
# Adapted from fmz200/wool_scripts endpoint references; see research/sources.lock.json.
name: 小红书开屏广告处理（可选）
desc: 只调整开屏广告时间；不改笔记、下载权限、水印或账号。 默认不导入，需设备验收。
http:
  mitm:
  - edith.xiaohongshu.com
  script:
  - match: ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config(\?|$)
    name: jimmy_xiaohongshu_ads
    type: response
    require-body: true
    timeout: 5
script-providers:
  jimmy_xiaohongshu_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/xiaohongshu.js
    interval: 86400
