# SPDX-License-Identifier: GPL-3.0-only
# Adapted from fmz200/wool_scripts endpoint references; see research/sources.lock.json.
name: 淘宝开屏广告处理（可选）
desc: 仅专用 splash API 中的广告条目；不拦整个首页、通用视频、领券或支付。不是独立天猫 App 支持声明。 默认不导入，需设备验收。
http:
  mitm:
  - guide-acs.m.taobao.com
  script:
  - match: ^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.wireless\.home\.splash\.awesome\.get(\/\d+(\.\d+)*\/?)?(\?|$)
    name: jimmy_taobao_ads
    type: response
    require-body: true
    timeout: 5
script-providers:
  jimmy_taobao_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/taobao.js
    interval: 86400
