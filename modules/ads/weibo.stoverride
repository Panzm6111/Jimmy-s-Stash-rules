# SPDX-License-Identifier: GPL-3.0-only
# Adapted from fmz200/wool_scripts endpoint references; see research/sources.lock.json.
name: 微博开屏广告处理（可选）
desc: 仅普通微博两个开屏实时/预加载接口；不改时间线、消息、会员或签到。 默认不导入，需设备验收。
http:
  mitm:
  - bootrealtime.uve.weibo.com
  - bootpreload.uve.weibo.com
  script:
  - match: ^https:\/\/bootrealtime\.uve\.weibo\.com\/v\d+\/ad\/realtime(\?|$)
    name: jimmy_weibo_ads
    type: response
    require-body: true
    timeout: 5
  - match: ^https:\/\/bootpreload\.uve\.weibo\.com\/v\d+\/ad\/preload(\?|$)
    name: jimmy_weibo_ads
    type: response
    require-body: true
    timeout: 5
script-providers:
  jimmy_weibo_ads:
    url: https://raw.githubusercontent.com/Panzm6111/Jimmy-s-Stash-rules/main/scripts/ads/weibo.js
    interval: 86400
